{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": "off",
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "useSemanticElements": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/db-raw"],
                "message": "Only the provenance functions may write a tracked model. Use applyObservation, createWithObservation or deleteWithObservation."
              },
              {
                "group": ["**/generated/prisma", "**/generated/prisma/**"],
                "importNamePattern": "PrismaClient|[*]",
                "message": "Import the client from @/lib/db, which can't write tracked models."
              }
            ]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/db.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/db-raw"],
                    "message": "Only the provenance functions may write a tracked model. Use applyObservation, createWithObservation or deleteWithObservation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/provenance/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/generated/prisma", "**/generated/prisma/**"],
                    "importNamePattern": "PrismaClient|[*]",
                    "message": "Import the client from @/lib/db, which can't write tracked models."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__/**",
        "tests/**",
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
